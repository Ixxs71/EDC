<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/brand_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtDashcamDirStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:text="@string/status_idle" />

        <Button
            android:id="@+id/btnOpenDashcamFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_open_dashcam_folder" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/spinnerDashcamQuality"
            android:text="@string/label_dashcam_quality" />

        <Spinner
            android:id="@+id/spinnerDashcamQuality"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/editDashcamClipMinutes"
            android:text="@string/label_dashcam_clip_minutes" />

        <EditText
            android:id="@+id/editDashcamClipMinutes"
            android:importantForAutofill="no"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:inputType="number"
            android:digits="0123456789"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/editDashcamCapGb"
            android:text="@string/label_dashcam_cap_gb" />

        <EditText
            android:id="@+id/editDashcamCapGb"
            android:importantForAutofill="no"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:inputType="number"
            android:digits="0123456789"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtDashcamRetention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textStyle="italic"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/checkDashcamAutoAA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/label_auto_aa" />

        <Button
            android:id="@+id/btnToggleDashcam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_start_dashcam" />

        <TextView
            android:id="@+id/txtDashcamStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/status_dashcam_off" />

    </LinearLayout>
</ScrollView>
