<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/brand_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtAboutVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/about_title_license" />
        <TextView
            style="@style/AboutBody"
            android:text="@string/about_body_license" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/about_title_privacy" />
        <TextView
            style="@style/AboutBody"
            android:text="@string/about_body_privacy" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/about_title_data" />
        <TextView
            style="@style/AboutBody"
            android:text="@string/about_body_data" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/about_title_dashcam" />
        <TextView
            style="@style/AboutBody"
            android:text="@string/about_body_dashcam" />

        <LinearLayout
            android:id="@+id/aboutSupportBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                style="@style/SectionTitle"
                android:text="@string/about_title_support" />
            <TextView
                style="@style/AboutBody"
                android:text="@string/about_body_support" />
            <Button
                android:id="@+id/btnSupport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_support" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
